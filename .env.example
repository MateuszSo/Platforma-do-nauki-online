# Skopiuj ten plik do .env i uzupełnij prawdziwymi wartościami.
# Plik .env jest ignorowany przez git - NIGDY go nie commituj do repozytorium!

# Połączenie z MongoDB Atlas (dane dostępowe)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Nazwa bazy danych
DB_NAME=userAuthDB

# Klucz do podpisu tokenów JWT
JWT_SECRET=<strong-random-secret>

# URL aplikacji frontend (np. http://localhost:3000) – używany przy CORS
CORS_ORIGIN=http://localhost:3000

# URL API backendu (np. http://localhost:4000) – używany przez frontend
REACT_APP_API_URL=http://localhost:4000
